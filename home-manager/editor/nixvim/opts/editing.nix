{
  # Character encoding (UTF-8 primary, with Japanese fallbacks)
  encoding = "utf-8";
  fileencodings = "utf-8,euc-jp,cp932";

  # Backspace behavior: allow backspace over indent, line breaks, and insert start
  backspace = "indent,eol,start";

  tabstop = 2;
  shiftwidth = 2;
  expandtab = true;
}
