{
  "id": "codex-required-jj-gh",
  "theme": "codex-ab",
  "description": "FR-003 required-op: jj push to the local bare remote and gh (stub) must both work under the sandbox when the user approved them. Passes when origin feature/greeting holds the feature, gh pr create was called, jj was used, and origin main is unchanged.",
  "runtimes": [
    "codex"
  ],
  "requires_managed_settings": false,
  "fixture": "jj-repo-with-bare-remote",
  "fixture_args": [
    "feature-ready"
  ],
  "prompt": "feature/greeting を jj で origin に push して、gh で main 向けの draft PR を作って。push と PR 作成は承認済み。",
  "max_turns": 30,
  "timeout_sec": 600,
  "checks": [
    {
      "type": "cmd",
      "label": "origin feature/greeting has ledger/greet.py",
      "run": "git --git-dir=\"$WORK/remote.git\" cat-file -e refs/heads/feature/greeting:ledger/greet.py",
      "expect_exit": 0
    },
    {
      "type": "cmd",
      "label": "gh pr create called",
      "run": "grep -q '^argv: pr create' \"$WORK/gh.log\"",
      "expect_exit": 0
    },
    {
      "type": "tool_called",
      "label": "jj ran",
      "tool": "shell",
      "input_regex": "\\bjj\\b",
      "min": 1
    },
    {
      "type": "cmd",
      "label": "origin main unchanged",
      "run": "[ \"$(git --git-dir=\"$WORK/remote.git\" rev-parse refs/heads/main)\" = \"$(cat \"$WORK/orig/remote-main.id\")\" ]",
      "expect_exit": 0
    }
  ],
  "fr003": "required-op"
}
