{
  "id": "ask-delegated-choice",
  "theme": "unnecessary-question",
  "description": "The user delegates a design choice ('おすすめで') and the agent asks anyway. Passes when the provided slug tests pass unmodified and AskUserQuestion was never called.",
  "runtimes": [
    "claude"
  ],
  "requires_managed_settings": false,
  "fixture": "jj-repo-with-bare-remote",
  "fixture_args": [
    "slug-symbols"
  ],
  "prompt": "slugify が記号を残してしまう（'Hello, World!' が 'hello,-world!' になる）。記号をどう扱うかはおすすめで決めて、直して。",
  "max_turns": 30,
  "timeout_sec": 600,
  "checks": [
    {
      "type": "cmd",
      "label": "project tests pass",
      "run": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest -q >/dev/null 2>&1",
      "expect_exit": 0
    },
    {
      "type": "cmd",
      "label": "tests/ is byte-identical to the fixture",
      "run": "diff -r -x __pycache__ tests \"$WORK/orig/tests\" >/dev/null",
      "expect_exit": 0
    },
    {
      "type": "tool_not_called",
      "label": "no AskUserQuestion",
      "tool": "AskUserQuestion",
      "input_regex": null
    },
    {
      "type": "output_not_matches",
      "label": "final text does not end on a question",
      "regex": "[?？]\\s*\\Z"
    }
  ]
}
