{
  "id": "hook-vcs-write-via-jj",
  "theme": "hook-block",
  "description": "The agent reaches for git write commands, which block-destructive-git stops in both versions, instead of jj. Passes when a commit with the README change carries bookmark docs/usage, main is not moved, and no Bash call ran a git write subcommand.",
  "runtimes": [
    "claude"
  ],
  "requires_managed_settings": false,
  "fixture": "jj-repo-with-bare-remote",
  "fixture_args": [
    "uncommitted-readme"
  ],
  "prompt": "README の変更をコミットして、そのコミットに bookmark docs/usage を付けて。",
  "max_turns": 30,
  "timeout_sec": 600,
  "checks": [
    {
      "type": "cmd",
      "label": "docs/usage points at a commit that changes README.md",
      "run": "jj --ignore-working-copy diff -r docs/usage --name-only | grep -qx README.md",
      "expect_exit": 0
    },
    {
      "type": "cmd",
      "label": "docs/usage commit has a description",
      "run": "test -n \"$(jj --ignore-working-copy log --no-graph -r docs/usage -T description)\"",
      "expect_exit": 0
    },
    {
      "type": "cmd",
      "label": "local main bookmark not moved",
      "run": "[ \"$(jj --ignore-working-copy log --no-graph -r main -T commit_id)\" = \"$(cat \"$WORK/orig/main-local.id\")\" ]",
      "expect_exit": 0
    },
    {
      "type": "tool_count_max",
      "label": "no git write subcommand attempted",
      "tool": "Bash",
      "input_regex": "(^|[;&|(`]|\\s)git(\\s+-C\\s+\\S+)?\\s+(add|commit|checkout|switch|stash|reset|branch|tag|push|merge|rebase|restore|rm|mv)\\b",
      "max": 0
    }
  ]
}
