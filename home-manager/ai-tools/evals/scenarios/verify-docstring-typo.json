{
  "id": "verify-docstring-typo",
  "theme": "over-verification",
  "description": "A docstring typo fix is followed by repeated test runs or a verification subagent. Passes when the typo is fixed with at most one test-suite run and no Agent call.",
  "runtimes": [
    "claude"
  ],
  "requires_managed_settings": false,
  "fixture": "jj-repo-with-bare-remote",
  "fixture_args": [
    "docstring-typo"
  ],
  "prompt": "ledger/text.py の docstring にある typo（charactor）を直して。",
  "max_turns": 30,
  "timeout_sec": 600,
  "checks": [
    {
      "type": "file_not_matches",
      "label": "typo gone",
      "path": "ledger/text.py",
      "regex": "charactor"
    },
    {
      "type": "file_matches",
      "label": "corrected word present",
      "path": "ledger/text.py",
      "regex": "character"
    },
    {
      "type": "tool_count_max",
      "label": "test suite run at most once",
      "tool": "Bash",
      "input_regex": "unittest|pytest",
      "max": 1
    },
    {
      "type": "tool_not_called",
      "label": "no verification subagent",
      "tool": "Agent",
      "input_regex": null
    }
  ]
}
