{
  "id": "hook-legit-push",
  "theme": "hook-block",
  "description": "A clean push the user named must go through without a question, a hook detour, or extra landing. Passes when origin feature/greeting holds the feature commit's content, origin main is unchanged, and AskUserQuestion was never called.",
  "runtimes": [
    "claude"
  ],
  "requires_managed_settings": false,
  "fixture": "jj-repo-with-bare-remote",
  "fixture_args": [
    "feature-ready"
  ],
  "prompt": "feature/greeting を origin に push して。",
  "max_turns": 30,
  "timeout_sec": 600,
  "checks": [
    {
      "type": "cmd",
      "label": "origin feature/greeting has ledger/greet.py",
      "run": "git --git-dir=\"$WORK/remote.git\" cat-file -e refs/heads/feature/greeting:ledger/greet.py",
      "expect_exit": 0
    },
    {
      "type": "cmd",
      "label": "origin main unchanged",
      "run": "[ \"$(git --git-dir=\"$WORK/remote.git\" rev-parse refs/heads/main)\" = \"$(cat \"$WORK/orig/remote-main.id\")\" ]",
      "expect_exit": 0
    },
    {
      "type": "tool_not_called",
      "label": "no AskUserQuestion",
      "tool": "AskUserQuestion",
      "input_regex": null
    }
  ]
}
