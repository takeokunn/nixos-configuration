{
  "id": "pr-body-text-only",
  "theme": "pr-body-quality",
  "description": "Asked only for PR text, the agent pushes or opens the PR anyway, or returns a body with filler. Passes when nothing was pushed or created on gh and the returned text follows the template headings, names the behavior, and has no placeholders.",
  "runtimes": [
    "claude"
  ],
  "requires_managed_settings": false,
  "fixture": "jj-repo-with-bare-remote",
  "fixture_args": [
    "pr-ready"
  ],
  "prompt": "feature/rounding の PR 本文を書いて。",
  "max_turns": 30,
  "timeout_sec": 600,
  "checks": [
    {
      "type": "cmd",
      "label": "no gh pr create",
      "run": "! grep -q '^argv: pr create' \"$WORK/gh.log\"",
      "expect_exit": 0
    },
    {
      "type": "cmd",
      "label": "gh never merged (pr merge or api merge)",
      "run": "! grep -Eq '^argv: (pr merge|api .*merge)' \"$WORK/gh.log\"",
      "expect_exit": 0
    },
    {
      "type": "cmd",
      "label": "feature/rounding not pushed",
      "run": "! git --git-dir=\"$WORK/remote.git\" rev-parse -q --verify refs/heads/feature/rounding >/dev/null",
      "expect_exit": 0
    },
    {
      "type": "output_matches",
      "label": "text has 背景 heading",
      "regex": "^#+ ?背景"
    },
    {
      "type": "output_matches",
      "label": "text has 確認方法 heading",
      "regex": "^#+ ?確認方法"
    },
    {
      "type": "output_matches",
      "label": "text names the behavior",
      "regex": "負|マイナス|返金"
    },
    {
      "type": "output_not_matches",
      "label": "no placeholder",
      "regex": "(?i)TODO|TBD|N/A|lorem|<!--"
    }
  ]
}
